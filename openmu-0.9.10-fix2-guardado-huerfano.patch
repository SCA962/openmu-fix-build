+    /// <summary>
+    /// Reconciles the entries of a <see cref="DbUpdateConcurrencyException"/> with the database, so the
+    /// save can be retried instead of failing forever with the same stale command.
+    /// </summary>
+    /// <remarks>
+    /// Deliberately conservative: nothing is written which was not there before.
+    /// <list type="bullet">
+    /// <item>Row is gone and the entry is a deletion: the deletion already happened somewhere else, so
+    /// the entry is just dropped.</item>
+    /// <item>Row is gone and the entry is an update: the entity was deleted by someone else. It is
+    /// detached (never re-inserted - that could resurrect a deleted item and duplicate it) and logged
+    /// with its type and key, so the cause can be tracked down.</item>
+    /// <item>Row exists: the regular optimistic concurrency case; the original values are refreshed
+    /// from the database and the in-memory state is kept.</item>
+    /// </list>
+    /// </remarks>
+    /// <param name="exception">The concurrency exception.</param>
+    /// <param name="cancellationToken">The cancellation token.</param>
+    /// <returns><c>true</c> if at least one entry was reconciled and the save should be retried.</returns>
+    private async ValueTask<bool> TryReconcileStaleEntriesAsync(DbUpdateConcurrencyException exception, CancellationToken cancellationToken)
+    {
+        var reconciled = false;
+        foreach (var entry in exception.Entries)
+        {
+            var description = DescribeEntry(entry);
+            try
+            {
+                var databaseValues = await entry.GetDatabaseValuesAsync(cancellationToken).ConfigureAwait(false);
+                if (databaseValues is not null)
+                {
+                    this._logger.LogWarning("Concurrency conflict while saving: {Entry} was changed in the database by someone else; keeping the in-memory state.", description);
+                    entry.OriginalValues.SetValues(databaseValues);
+                    reconciled = true;
+                    continue;
+                }
+
+                switch (entry.State)
+                {
+                    case EntityState.Deleted:
+                        this._logger.LogWarning("Concurrency conflict while saving: {Entry} was already deleted in the database; dropping the deletion.", description);
+                        entry.State = EntityState.Detached;
+                        reconciled = true;
+                        break;
+                    case EntityState.Modified:
+                        this._logger.LogError("Concurrency conflict while saving: the row of {Entry} does not exist in the database anymore, so its changes cannot be saved. Detaching it to save the rest of the progress.", description);
+                        entry.State = EntityState.Detached;
+                        reconciled = true;
+                        break;
+                    default:
+                        this._logger.LogError("Concurrency conflict while saving: {Entry} has no row in the database and an unexpected state; not reconciled.", description);
+                        break;
+                }
+            }
+            catch (Exception ex)
+            {
+                this._logger.LogWarning(ex, "Concurrency conflict while saving: could not reconcile {Entry}.", description);
+            }
+        }
+
+        return reconciled;
+    }
+
+    private static string DescribeEntry(EntityEntry entry)
+    {
+        try
+        {
+            var keyProperties = entry.Metadata.FindPrimaryKey()?.Properties
+                .Select(property => entry.Property(property.Name).CurrentValue?.ToString() ?? "null");
+            var keyText = keyProperties is null ? "?" : string.Join("/", keyProperties);
+            var foreignKeys = entry.Properties
+                .Where(property => property.Metadata.IsForeignKey())
+                .Select(property => $"{property.Metadata.Name}={property.CurrentValue?.ToString() ?? "null"}");
+            return $"{entry.Metadata.ClrType.Name} [{keyText}] ({entry.State}; {string.Join(", ", foreignKeys)})";
+        }
+        catch (Exception)
+        {
+            return entry.Metadata.ClrType.Name;
+        }
+    }
