+    /// <summary>
+    /// Tries to bring the entries reported by a <see cref="DbUpdateConcurrencyException"/> back in
+    /// line with the database, so that a following attempt writes against a clean state.
+    /// </summary>
+    /// <param name="exception">The exception reported by the failed save.</param>
+    /// <param name="cancellationToken">The cancellation token.</param>
+    /// <returns><c>true</c> if the save is worth retrying; <c>false</c> if the caller must give up.</returns>
+    /// <remarks>
+    /// Three cases, and the third one is the reason this method returns a value instead of always
+    /// cleaning up:
+    /// <list type="bullet">
+    /// <item>The row still exists - it just changed. The original values are rebased on the database
+    /// values, so the retry updates the current row instead of a stale snapshot.</item>
+    /// <item>The row is gone and the entry is <see cref="EntityState.Deleted"/> - deleting it was the
+    /// intention and somebody already did it (the crafting handler destroying a consumed item is the
+    /// common case). Dropping the entry is safe: there is nothing left to delete.</item>
+    /// <item>The row is gone and the entry is <see cref="EntityState.Modified"/> - detaching it would
+    /// leave the object alive in memory, and a later Attach (a trade, a storage move) could insert it
+    /// again as a new row. That is exactly how items get duplicated, so this method refuses to
+    /// "recover" and leaves the decision to the caller.</item>
+    /// </list>
+    /// </remarks>
+    private async ValueTask<bool> TryReconcileStaleEntriesAsync(DbUpdateConcurrencyException exception, CancellationToken cancellationToken)
+    {
+        if (exception.Entries.Count == 0)
+        {
+            // Without entries there is nothing to reconcile, and a retry would just repeat the same
+            // failing statement.
+            this._logger.LogError(exception, "Save failed with a concurrency conflict which reports no entries; not retrying.");
+            return false;
+        }
+
+        // The failing save released the context lock on its way out, so take it again: reconciling
+        // reads the change tracker and queries the database through the same context, and must not
+        // race another save on it.
+        using var l = await this._lock.LockAsync().ConfigureAwait(false);
+
+        var reconciled = false;
+        foreach (var entry in exception.Entries)
+        {
+            if (entry.State == EntityState.Added)
+            {
+                // An entry which is being inserted has no row to compare against by definition, so
+                // GetDatabaseValuesAsync would return null and the check below would wrongly treat it
+                // as unrecoverable. It rides along in the same command batch as the failing statement;
+                // once the others are reconciled, the retry inserts it normally.
+                continue;
+            }
+
+            var databaseValues = await entry.GetDatabaseValuesAsync(cancellationToken).ConfigureAwait(false);
+            if (databaseValues is not null)
+            {
+                entry.OriginalValues.SetValues(databaseValues);
+                this._logger.LogWarning("Save conflict resolved: {Entry} changed in the database; retrying against the current row.", DescribeEntry(entry));
+                reconciled = true;
+                continue;
+            }
+
+            if (entry.State == EntityState.Deleted)
+            {
+                this._logger.LogWarning("Save conflict resolved: {Entry} is already gone from the database; dropping the pending delete.", DescribeEntry(entry));
+                entry.State = EntityState.Detached;
+                reconciled = true;
+                continue;
+            }
+
+            this._logger.LogError("Save conflict NOT resolvable: {Entry} no longer exists in the database. Leaving it attached on purpose - detaching it could resurrect a deleted row as a duplicate later on.", DescribeEntry(entry));
+            return false;
+        }
+
+        return reconciled;
+    }
+
+    /// <summary>
+    /// Describes an entry for the log: which entity it is, its key, its state and its foreign keys.
+    /// Without this, a concurrency failure only says "expected to affect 1 row(s)" and gives no clue
+    /// about which game action deleted the row.
+    /// </summary>
+    /// <param name="entry">The entry to describe.</param>
+    /// <returns>A one line description.</returns>
+    private static string DescribeEntry(EntityEntry entry)
+    {
+        var primaryKey = entry.Metadata.FindPrimaryKey();
+        var keyText = primaryKey is null
+            ? "no key"
+            : string.Join(", ", primaryKey.Properties.Select(property => $"{property.Name}={entry.Property(property.Name).CurrentValue}"));
+        var foreignKeys = entry.Metadata.GetForeignKeys()
+            .SelectMany(foreignKey => foreignKey.Properties)
+            .Select(property => $"{property.Name}={entry.Property(property.Name).CurrentValue}")
+            .Distinct()
+            .ToList();
+        var foreignKeyText = foreignKeys.Count == 0 ? string.Empty : $", fk: {string.Join(", ", foreignKeys)}";
+        return $"{entry.Entity.GetType().Name} ({keyText}, state: {entry.State}{foreignKeyText})";
+    }
