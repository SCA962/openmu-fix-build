+    /// <summary>
+    /// Counts the entities tracked by this context, for the log. A context which is failing to save
+    /// and tracks thousands of entities is a different problem from one which tracks a handful, and
+    /// today the failure line says nothing about it. This adds no log line of its own: it only fills
+    /// a placeholder in a line which is already written when a save gives up.
+    /// </summary>
+    /// <returns>The number of tracked entries, or -1 if the tracker could not be read.</returns>
+    /// <remarks>
+    /// Enumerating the change tracker normally runs change detection, which is exactly the operation
+    /// that throws when another flow mutates a tracked collection at the same time - and this runs on
+    /// a path where the context is already known to be unhealthy. Detection is therefore switched off
+    /// around the count (so the call cannot mutate tracker state either), and any failure returns -1
+    /// instead of replacing the real exception with a logging one.
+    /// </remarks>
+    private int CountTrackedEntriesSafely()
+    {
+        try
+        {
+            var autoDetectChanges = this.Context.ChangeTracker.AutoDetectChangesEnabled;
+            this.Context.ChangeTracker.AutoDetectChangesEnabled = false;
+            try
+            {
+                return this.Context.ChangeTracker.Entries().Count();
+            }
+            finally
+            {
+                this.Context.ChangeTracker.AutoDetectChangesEnabled = autoDetectChanges;
+            }
+        }
+        catch
+        {
+            return -1;
+        }
+    }
